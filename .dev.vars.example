# Local secrets for `npm run worker:dev` (wrangler dev in worker/).
# Copy to worker/.dev.vars and fill in. .dev.vars is gitignored — never commit it.
# In production these are Worker secrets: wrangler secret put TELEGRAM_BOT_TOKEN (and TELEGRAM_CHAT_ID).

# Bot token from @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Chat that receives enquiries
TELEGRAM_CHAT_ID=
# "1" also allows http://localhost:* origins. Local only — never set this in production.
DEV=1
