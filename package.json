{
  "name": "sachenkolabs-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint:css": "stylelint \"src/css/**/*.css\"",
    "lint:js": "eslint .",
    "lint:html": "html-validate \"dist/*.html\"",
    "check": "npm run lint:css && npm run lint:js && npm run build && npm run lint:html",
    "shots": "node scripts/shots.mjs",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "html-validate": "^11.16.1",
    "lucide-static": "^1.48.0",
    "playwright": "^1.63.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.3.1",
    "wrangler": "4.147.0"
  }
}
